{
  "name": "bedrock",
  "productName": "Bedrock",
  "version": "0.1.3",
  "private": true,
  "description": "Bedrock notes app: free, open-source, works with Obsidian vaults and plugins. Bedrock by Toolbay.",
  "license": "MIT",
  "author": "Toolbay contributors",
  "homepage": "https://github.com/sriptcollector/bedrock",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && node test/e2e/smoke.mjs",
    "test:e2e:graph-canvas": "npm run build && node test/e2e/graph-canvas.mjs",
    "test:e2e:settings": "npm run build && node test/e2e/settings-tabs.mjs",
    "selftest": "node scripts/build.mjs && electron . --selftest",
    "dist": "node scripts/build.mjs --prod && node scripts/manifest.mjs && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "node scripts/build.mjs --prod && electron-builder --config electron-builder.config.cjs --dir",
    "manifest": "node scripts/manifest.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "katex": "^0.19.0",
    "lucide": "^1.61.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "playwright": "^1.64.1",
    "png2icons": "^2.0.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
